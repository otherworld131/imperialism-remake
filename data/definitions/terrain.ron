        (name: "Hills", defense_bonus: 0.3),
        (name: "Forest", defense_bonus: 0.2),
        (name: "Mountain", defense_bonus: 0.5),
        (name: "Desert", defense_bonus: 0.0),
        (name: "Swamp", defense_bonus: 0.15),
        (name: "Tundra", defense_bonus: 0.0),
        (name: "Sea", defense_bonus: 0.0),
    ],
)
