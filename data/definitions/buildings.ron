// Building definitions — data-driven, moddable
// Defines all 16 building types, their costs, and production capabilities.
//
// Categories:
//   Mill         — converts raw resources into processed materials
//   Factory      — converts processed materials into finished goods
//   Late-Game    — unlocked by Oil Drilling tech; processes oil or provides bonuses
//   Infrastructure — fixed utility buildings in every Great Power capital

(
    buildings: [
        // ── Mills — convert raw resources into processed materials ──────

        (
            name: "Lumber Mill",
            category: "Mill",
            input: Some("Timber"),
            output: Some("Lumber"),
            base_capacity: Some(2),
            expansion_cost_per_unit: Some((lumber: 1, steel: 1)),
        ),
        (
            name: "Steel Mill",
